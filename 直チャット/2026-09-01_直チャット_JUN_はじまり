後で実際に作業をされる際にそのままコピペや調整ができるよう、Playwrightを使用したコードの枠組みです。機種名はリスト形式でパラメータ化し、ログイン後にコンボボックスを切り替えて1ページ分の予約データを抽出する設計にしています。
Python
from playwright.sync_api import sync_playwright

# ==========================================
# 設定エリア（環境に合わせて変更）
# ==========================================
DIMORA_LOGIN_URL = "https://dimora.jp/dc/s/login" # ディモーラのログインURL
USER_ID = "your_email@example.com"
USER_PASS = "your_password"

# パラメータ化した3台の機種名（コンボボックスの表示名）
DIGA_NAMES = [
    "リビングのDIGA",  # 機種1
    "寝室のDIGA",     # 機種2
    "書斎のDIGA"      # 機種3
]

def run_dimora_automation():
    with sync_playwright() as p:
        # 画面を表示しない「ヘッドレスモード」で起動（Debian/VAIO用）
        browser = p.chromium.launch(headless=True)
        page = browser.new_page()

        try:
            # 1. ログイン処理
            page.goto(DIMORA_LOGIN_URL)
            page.fill("input[name='loginId']", USER_ID) # 実際のHTML要素名に合わせる
            page.fill("input[name='password']", USER_PASS)
            page.click("button[type='submit']")
            page.wait_for_load_state("networkidle")

            # 2. 予約一覧ページへ移動
            page.goto("https://dimora.jp/dc/s/reservation/list")

            # 3. パラメータをループして3台分を順次取得
            for diga_name in DIGA_NAMES:
                print(f"[{diga_name}] のデータを取得中...")
                
                # コンボボックスで機種を変更
                page.select_option("select#digaSelect", label=diga_name)
                page.wait_for_load_state("networkidle")
                
                # 4. 1ページ分（最大100件）のテキスト要素を一括抽出
                # 対象エリアのHTMLセレクタを指定
                reservation_data = page.locator("#reservationListArea").inner_text()
                
                # ここで取得した `reservation_data` をGoogleスプレッドシートやファイルへ保存する処理を入れる
                print(f"[{diga_name}] 取得成功（データ量: {len(reservation_data)}文字）")

        except Exception as e:
            print(f"エラー発生: {e}")
        finally:
            browser.close()

if __name__ == "__main__":
    run_dimora_automation()


