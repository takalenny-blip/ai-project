function doPost(e) {
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    const data = JSON.parse(e.postData.contents);
    
    const lastRow = sheet.getLastRow();
    const newRecordId = "R" + String(lastRow).padStart(3, '0');
    
    const rowData = [
      newRecordId,
      data["経験ID"] || "",
      data["日付"] || "",
      data["タイトル"] || "",
      data["カテゴリ"] || "",
      data["何があった？"] || "",
      data["たかの感想・気持ち"] || "",
      data["技術的な記録"] || "",
      data["JUNメモ"] || "",
      data["バドメモ"] || "",
      data["関連写真"] || "",
      data["記事候補"] || "",
      data["記事ステータス"] || ""
    ];
    
    sheet.appendRow(rowData);
    
    return ContentService.createTextOutput(JSON.stringify({ status: "success", recordId: newRecordId }))
      .setMimeType(ContentService.MimeType.JSON);
